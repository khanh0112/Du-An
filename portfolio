@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@300;400;500;600;700&display=swap');
@import "tailwindcss";

@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
  --font-display: "Space Grotesk", sans-serif;

  --color-neon-blue: #00d2ff;
  --color-neon-purple: #9d50bb;
  --color-dark-bg: #0b0e14;
  --color-dark-card: #161b22;
}

@layer base {
  body {
    @apply bg-dark-bg text-gray-300 font-sans selection:bg-neon-blue/30;
  }

  h1, h2, h3, h4, h5, h6 {
    @apply font-display text-white font-bold tracking-tight;
  }
}

.glass-card {
  @apply bg-dark-card/40 backdrop-blur-md border border-white/10 rounded-2xl;
}

.neon-glow {
  box-shadow: 0 0 20px rgba(0, 210, 255, 0.2);
}

.neon-border {
  @apply border border-neon-blue/30 hover:border-neon-blue/60 transition-colors;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  @apply bg-dark-bg;
}

::-webkit-scrollbar-thumb {
  @apply bg-gray-800 rounded-full hover:bg-gray-700 transition-colors;
}
